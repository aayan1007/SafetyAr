<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/assessmentCameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.safetyar.app.ar.AROverlayView
        android:id="@+id/assessmentArOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Assessment HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#990F172A"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExamSector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRACTICAL COMPETENCY EXAM"
                    android:textColor="@color/hazard_orange"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExamTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:60 REMAINING"
                    android:textColor="@color/text_on_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExamScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_certified"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="SCORE: 0%"
                android:textColor="@color/hazard_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Spot 3 hazards &amp; apply correct SOP controls before time expires."
            android:textColor="@color/text_on_dark_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Hazard Mitigation Interactive Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardExamHazardAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/safety_primary"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvExamHazardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hazard Selected"
                android:textColor="@color/text_on_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExamHazardDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Analyze danger and select appropriate regulatory mitigation."
                android:textColor="@color/text_on_dark_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExamApplyMitigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Apply SOP &amp; Secure Hazard"
                android:textColor="@color/safety_on_primary"
                app:backgroundTint="@color/safety_primary"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
