<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Main Exam Container -->
    <LinearLayout
        android:id="@+id/containerExamActive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar & Question Progress Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBackFromAssessment"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/text_on_dark"
                    android:contentDescription="Exit" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAssessmentModuleTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Industrial Safety Competency Exam"
                        android:textColor="@color/text_on_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuestionCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Question 1 of 5"
                        android:textColor="@color/safety_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAssessmentTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_warning"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="05:00"
                    android:textColor="@color/hazard_orange"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressAssessment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:progress="20"
                app:indicatorColor="@color/safety_primary"
                app:trackColor="@color/safety_secondary_container"
                app:trackCornerRadius="4dp" />

            <!-- Safety Critical Flashing Banner -->
            <TextView
                android:id="@+id/tvSafetyCriticalBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/badge_warning"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="\u26A0 ZERO-TOLERANCE SAFETY CRITICAL QUESTION"
                android:textColor="@color/hazard_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Scrollable Question Body -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Question Header Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvQuestionCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FIRE SUPPRESSION"
                                android:textColor="@color/safety_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvDifficultyBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_warning"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="INTERMEDIATE \u2022 20 PTS"
                                android:textColor="@color/hazard_orange"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Optional Hazard Diagram / Image -->
                        <ImageView
                            android:id="@+id/ivQuestionHazardImage"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="12dp"
                            android:scaleType="fitCenter"
                            android:background="@color/bg_dark"
                            android:padding="8dp"
                            android:src="@drawable/ic_hazard_warning"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvQuestionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingMultiplier="1.3"
                            android:text="Which fire extinguisher media is STRICTLY PROHIBITED on energized electrical equipment?"
                            android:textColor="@color/text_on_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dynamic Options Container -->
                <TextView
                    android:id="@+id/tvAnswerInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="SELECT THE CORRECT ACTION:"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Standard Multiple Choice / Scenario Container -->
                <RadioGroup
                    android:id="@+id/rgOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Sequence / Order Container (For SEQUENCE_ORDER type) -->
                <LinearLayout
                    android:id="@+id/layoutSequenceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap the items below in the correct operational sequence (1st \u2192 2nd \u2192 3rd \u2192 4th):"
                        android:textColor="@color/hazard_blue"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/containerSequenceItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetSequence"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset Sequence Order"
                        android:textColor="@color/hazard_orange"
                        android:textSize="12sp"
                        android:layout_gravity="end" />
                </LinearLayout>

                <!-- AR Simulated Action Container -->
                <LinearLayout
                    android:id="@+id/layoutArActionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1A0284C7"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/hazard_blue"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_ar_cube"
                                app:tint="@color/hazard_blue" />

                            <TextView
                                android:id="@+id/tvArActionPrompt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="Practical AR action evaluated in live 3D environment."
                                android:textColor="@color/text_on_dark"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@color/surface_card">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitAnswer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Next Question \u2192"
                android:textColor="@color/safety_on_primary"
                android:textSize="15sp"
                app:backgroundTint="@color/safety_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Post-Exam Comprehensive Evaluation Result Overlay (PASSED or FAILED) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutAssessmentResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/bg_dark"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Result Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResultHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/hazard_green"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/ivResultIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/hazard_green" />

                    <TextView
                        android:id="@+id/tvResultDecisionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="COMPETENCY EXAM PASSED"
                        android:textColor="@color/hazard_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvResultScoreDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="85% \u2022 85 / 100 Points"
                        android:textColor="@color/text_on_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvResultPassThreshold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Passing Threshold: 70%"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="12sp" />

                    <!-- Critical Safety Violation Callout (if failed due to critical mistake) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCriticalSafetyViolation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="#2A991B1B"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/hazard_red"
                        app:strokeWidth="1.5dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="\u26A0 CRITICAL SAFETY ZERO-TOLERANCE RULE"
                                android:textColor="@color/hazard_red"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCriticalViolationDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingMultiplier="1.3"
                                android:text="Even though your numerical score exceeded the threshold, a critical safety violation occurred. Under DGMS life-safety regulations, committing an unsafe action constitutes mandatory failure."
                                android:textColor="@color/text_on_dark"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvCorrectCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4"
                                android:textColor="@color/hazard_green"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Correct"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="30dp"
                            android:background="@color/border_subtle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvIncorrectCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textColor="@color/hazard_red"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Incorrect"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="30dp"
                            android:background="@color/border_subtle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvCriticalMistakesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/hazard_orange"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Critical Errors"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weak Areas Diagnostic Card (Shown when errors exist) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeakAreas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDENTIFIED WEAK AREAS &amp; REMEDIATION"
                        android:textColor="@color/hazard_orange"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:id="@+id/containerWeakAreaItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions: Review Training, Retry Assessment, View Certificate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewCertificate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="View Digital Safety Pass \u2192"
                    android:textColor="@color/safety_on_primary"
                    android:textSize="15sp"
                    app:backgroundTint="@color/hazard_green"
                    app:cornerRadius="12dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReviewTraining"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="\uD83D\uDCDA Review Training Lessons"
                    android:textColor="@color/text_on_dark"
                    android:textSize="14sp"
                    app:strokeColor="@color/safety_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryAssessment"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="\u21BB Retry Assessment"
                    android:textColor="@color/safety_on_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/safety_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReturnDashboard"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Return to Dashboard"
                    android:textColor="@color/text_on_dark_muted"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
