<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageButton
            android:id="@+id/btnBackFromSync"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/text_on_dark"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline Database &amp; Sync"
                android:textColor="@color/text_on_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guaranteed persistence in underground mines"
                android:textColor="@color/text_on_dark_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSyncStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/hazard_green"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOCAL QUEUE STATUS"
                    android:textColor="@color/safety_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSyncStateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_certified"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Synced"
                    android:textColor="@color/hazard_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPendingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 Pending Audit Records"
                android:textColor="@color/text_on_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSyncStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="All training completions and certificates are saved locally in Room database and queued for central synchronization."
                android:textColor="@color/text_on_dark_muted"
                android:textSize="12sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sync Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTriggerSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Force Immediate Sync Now"
        android:textColor="@color/safety_on_primary"
        app:backgroundTint="@color/safety_primary"
        app:cornerRadius="12dp" />

    <!-- Info Note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Note: When underground miners resurface or reconnect to mine Wi-Fi / 4G, WorkManager automatically pushes all accumulated assessments to the Central DGMS Portal without requiring manual intervention."
        android:textColor="@color/text_on_dark_muted"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.3" />

</LinearLayout>
