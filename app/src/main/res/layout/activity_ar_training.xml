<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- AR Camera Surface / TextureView Container -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Interactive AR HUD & Spatial Hazard Overlay -->
    <com.safetyar.app.ar.AROverlayView
        android:id="@+id/arOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#990F172A"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnCloseAr"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/safety_on_dark"
                android:contentDescription="Exit AR" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvArTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AR Safety Field Simulation"
                    android:textColor="@color/text_on_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvArTrackingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ARCore: Detecting Floor &amp; Working Face..."
                    android:textColor="@color/ar_target_reticle"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHazardProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_warning"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="0 / 3 SAFE"
                android:textColor="@color/hazard_orange"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pan camera to detect industrial hazards. Tap markers to inspect &amp; mitigate."
            android:textColor="@color/text_on_dark_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Selected Hazard SOP Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHazardDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/safety_primary"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvHazardSeverity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_warning"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="CRITICAL"
                    android:textColor="@color/hazard_red"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHazardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Unsupported Roof Strata"
                    android:textColor="@color/text_on_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHazardDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Severe fracture detected in immediate roof strata. DGMS Circular 3 of 2019."
                android:textColor="@color/text_on_dark_muted"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/border_subtle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANDATORY SOP ACTION:"
                android:textColor="@color/safety_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHazardSop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Erect hydraulic prop / roof bolt. Withdraw workers beyond 2m line."
                android:textColor="@color/text_on_dark"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMitigateHazard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Apply SOP &amp; Neutralize Hazard"
                android:textColor="@color/safety_on_primary"
                app:backgroundTint="@color/safety_primary"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
