<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnBackFromProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/text_on_dark"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/profile_title"
                    android:textColor="@color/text_on_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Worker Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/safety_primary"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:src="@drawable/ic_coal_mine"
                            app:tint="@color/safety_primary"
                            android:contentDescription="Worker Avatar" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvProfileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ramesh Soren"
                                android:textColor="@color/text_on_dark"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvProfileId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ID: WRK-JH-COAL-0891"
                                android:textColor="@color/text_on_dark_muted"
                                android:textSize="12sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvProfileStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_certified"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="COMPLIANT"
                            android:textColor="@color/hazard_green"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detailed Profile Information Grid -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMPLOYMENT &amp; UNIT CREDENTIALS"
                        android:textColor="@color/safety_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Organization -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/worker_org_label"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvProfileOrg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bharat Coking Coal Limited (BCCL), Dhanbad"
                        android:textColor="@color/text_on_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Department -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/worker_dept_label"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvProfileDept"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Moonidih Underground Project, Seam XVI"
                        android:textColor="@color/text_on_dark"
                        android:textSize="13sp" />

                    <!-- Trade -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/worker_trade_label"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvProfileTrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Underground Drill &amp; Strata Technician"
                        android:textColor="@color/text_on_dark"
                        android:textSize="13sp" />

                    <!-- Joining Date -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/worker_joining_label"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvProfileJoining"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="02 Sep 2026"
                        android:textColor="@color/text_on_dark"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 30-Day Orientation Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30-DAY ORIENTATION STATUS"
                        android:textColor="@color/safety_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProfileOrientationDay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Day 12 / 30"
                            android:textColor="@color/text_on_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileOrientationPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="40% Complete"
                            android:textColor="@color/safety_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressProfileOrientation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:progress="40"
                        app:indicatorColor="@color/safety_primary"
                        app:trackColor="@color/safety_secondary_container" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons: Change Language & Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileChangeLanguage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_change_language"
                android:textColor="@color/text_on_dark"
                app:strokeColor="@color/border_subtle"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/btn_logout"
                android:textColor="@color/hazard_red" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
