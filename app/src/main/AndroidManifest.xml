<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ARCore & Camera Features -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:name=".SafetyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafetyAR"
        tools:targetApi="34">

        <!-- Google ARCore Optional Flag for Broad Mid-Range Compatibility -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!-- 1. Splash Activity (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SafetyAR.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Language Selection Activity -->
        <activity
            android:name=".ui.language.LanguageSelectionActivity"
            android:exported="false" />

        <!-- 3. Worker Login Activity -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Worker Safety Dashboard Activity -->
        <activity
            android:name=".ui.dashboard.MainActivity"
            android:exported="false" />

        <!-- 5. Worker Profile Activity -->
        <activity
            android:name=".ui.profile.WorkerProfileActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <!-- 6. Training History Activity -->
        <activity
            android:name=".ui.history.TrainingHistoryActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <!-- 7. Emergency & Help Activity -->
        <activity
            android:name=".ui.help.HelpActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <!-- 8. Module Catalog & Details -->
        <activity
            android:name=".ui.modules.ModuleListActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <activity
            android:name=".ui.modules.ModuleDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.modules.ModuleListActivity" />

        <!-- 8a. 11-Step Interactive Microlearning Pathway -->
        <activity
            android:name=".ui.modules.ModuleLearningActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <!-- 8b. Primary SIH Demo: AR Module 1 Fire & Explosion Response -->
        <activity
            android:name=".ui.ar.FireExplosionArActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafetyAR.Fullscreen" />

        <!-- 8c. Primary SIH Demo: AR Module 2 Gas Leak & Confined Space -->
        <activity
            android:name=".ui.ar.GasConfinedSpaceArActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafetyAR.Fullscreen" />

        <!-- 9. AR Safety Training Activity -->
        <activity
            android:name=".ui.ar.ArSafetyTrainingActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafetyAR.Fullscreen" />

        <!-- 10a. Reusable Multi-Modal Assessment Engine Activity -->
        <activity
            android:name=".ui.assessment.AssessmentEngineActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <!-- 10b. AR Hazard Assessment & Scoring Activity -->
        <activity
            android:name=".ui.assessment.ArHazardAssessmentActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SafetyAR.Fullscreen" />

        <!-- 11. Worker Safety Certificate Activity -->
        <activity
            android:name=".ui.certificate.CertificateActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <!-- 12. QR Code Pass Scanner (Supervisor Verification) -->
        <activity
            android:name=".ui.certificate.QrScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <!-- 13. Offline Sync & Audit Activity -->
        <activity
            android:name=".ui.sync.SyncStatusActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <!-- FileProvider for Sharing Certificate Images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
